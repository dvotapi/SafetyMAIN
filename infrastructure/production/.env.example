# SafetyMAIN production environment — template.
#
# Copy to `.env` next to compose.yml ON THE SERVER ONLY and fill in real values.
# `.env` must never be committed: it holds the database password and the JWT
# signing secret.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value below is a placeholder. Do not reuse development defaults.

# --- Application ---------------------------------------------------------
APP_NAME=SafetyMAIN API
APP_VERSION=0.1.0
APP_ENV=production

# --- Database (separate database server; never a local container) --------
# postgresql+psycopg://<user>:<password>@<db-host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://<user>:<password>@<db-host>:5432/<database>?sslmode=require

# --- Authentication ------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters in production; development placeholders are rejected
# by backend/bootstrap/security_validation.py.
JWT_SECRET_KEY=<generate-a-strong-secret>
JWT_ALGORITHM=HS256
JWT_ISSUER=safetymain-prod
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_REFRESH_ABSOLUTE_TTL_SECONDS=7776000
REFRESH_TOKEN_ROTATION_ENABLED=true
AUTH_ENFORCEMENT=true

# Frontend and API share one public origin, so CORS stays disabled.
CORS_ALLOWED_ORIGINS=

# --- Frontend build-time public configuration ----------------------------
# Inlined into the client bundle by `next build`. Never put secrets here.
# Changing these requires rebuilding the frontend image.
NEXT_PUBLIC_APP_URL=https://<safetymain-domain>
NEXT_PUBLIC_API_BASE_URL=https://<safetymain-domain>
NEXT_PUBLIC_APP_ENV=production

# --- Host port bindings (loopback only) ----------------------------------
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=3100

# Image tag used for both application images.
SAFETYMAIN_IMAGE_TAG=latest
