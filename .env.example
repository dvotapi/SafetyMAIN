APP_NAME=SafetyMAIN API
APP_VERSION=0.1.0
APP_ENV=development

# PostgreSQL connection string used by persistence and readiness checks.
# Never expose this value in API responses or client-facing logs.
DATABASE_URL=postgresql+psycopg://safetymain:safetymain@localhost:5432/safetymain

# Comma-separated browser origins. Empty means CORS middleware is not enabled.
# Do not use "*" together with credentials.
CORS_ALLOWED_ORIGINS=

# JWT authentication settings. Replace the secret before production deployment.
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=safetymain

# When false, business routes keep header-only tenant context without auth enforcement.
AUTH_ENFORCEMENT=false
# DEFAULT_ORGANIZATION_ID=

# Object storage (ADR-0006). Matches the `minio` service in docker-compose.yml.
# Leave STORAGE_BUCKET empty to use in-memory storage outside production.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=safetymain-documents
STORAGE_ACCESS_KEY=safetymain
STORAGE_SECRET_KEY=safetymain-minio
STORAGE_PRESIGN_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=52428800

# Production example (APP_ENV=production):
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://...
# JWT_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))">
# JWT_ISSUER=safetymain-prod
# AUTH_ENFORCEMENT=true
# STORAGE_ENDPOINT_URL=https://storage.yandexcloud.net
# STORAGE_REGION=ru-central1
# STORAGE_BUCKET=<bucket>
# STORAGE_ACCESS_KEY=<static-key-id>
# STORAGE_SECRET_KEY=<static-key-secret>
# See docs/architecture/ProductionSecurityConfiguration.md
